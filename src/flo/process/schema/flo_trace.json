{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:flo:schema:trace:0.1",
  "title": "FLO Process Trace Dataset",
  "description": "Structural contract for observed process events aligned to, but separate from, a canonical FLO model.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "events"],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    }
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "process_id",
        "case_id",
        "activity_key",
        "timestamp",
        "lifecycle"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "process_id": {
          "type": "string",
          "minLength": 1
        },
        "process_version": {
          "type": "string",
          "minLength": 1
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "activity_key": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "lifecycle": {
          "type": "string",
          "enum": ["start", "complete", "cancel", "fail"]
        },
        "correlation_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "attributes": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
