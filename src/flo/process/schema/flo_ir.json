{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FLO IR",
  "type": "object",
  "required": ["process","nodes","edges"],
  "properties": {
    "process": {
      "type": "object",
      "required": ["id","name"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "version": { "oneOf": [{"type":"integer"},{"type":"string"}] },
        "owner": { "$ref": "#/definitions/named_identity" },
        "business_units": {
          "type": "array",
          "items": { "$ref": "#/definitions/named_identity" }
        },
        "metadata": {
          "type": "object",
          "properties": {
            "render": { "$ref": "#/definitions/render_intent" },
            "items": { "$ref": "#/definitions/canonical_item_collection" },
            "resources": { "$ref": "#/definitions/canonical_resource_collection" }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id","kind"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string", "enum": ["start","task","system_task","queue","wait","decision","end","subprocess","parallel_split","parallel_join"] },
          "name": { "type": "string" },
          "lane": { "type": "string" },
          "location": { "type": "string" },
          "subprocess_parent": { "type": "string", "minLength": 1 },
          "workers": {
            "type": "array",
            "items": { "type": "string" }
          },
          "equipment": {
            "type": "array",
            "items": { "type": "string" }
          },
          "note": { "type": "string" },
          "inputs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "outputs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "consumes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "produces": {
            "type": "array",
            "items": { "type": "string" }
          },
          "performed_by": {
            "type": "array",
            "items": { "type": "string" }
          },
          "uses": {
            "type": "array",
            "items": { "type": "string" }
          },
          "metadata": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source","target"],
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "string" },
          "target": { "type": "string" },
          "outcome": { "type": "string" },
          "label": { "type": "string" },
          "edge_type": { "type": "string" },
          "handoff": { "type": "boolean" },
          "rework": { "type": "boolean" },
          "metadata": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": false
      }
    },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id","name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["role","team","system"] },
          "metadata": { "type": "object", "additionalProperties": true }
        },
        "additionalProperties": false
      }
    }
  },
  "definitions": {
    "named_identity": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "metadata": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "canonical_item": {
      "type": "object",
      "required": ["id", "name", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["material", "information"] },
        "quantity": { "type": "object" },
        "metadata": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "canonical_item_collection": {
      "oneOf": [
        { "type": "array", "items": { "$ref": "#/definitions/canonical_item" } },
        {
          "type": "object",
          "minProperties": 1,
          "properties": { "name": { "type": "string", "minLength": 1 } },
          "patternProperties": {
            "^(?!name$).+": { "$ref": "#/definitions/canonical_item_collection" }
          },
          "additionalProperties": false
        }
      ]
    },
    "canonical_resource": {
      "type": "object",
      "required": ["id", "name", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["person", "equipment"] },
        "quantity": { "type": "object" },
        "metadata": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": true
    },
    "canonical_resource_collection": {
      "oneOf": [
        { "type": "array", "items": { "$ref": "#/definitions/canonical_resource" } },
        {
          "type": "object",
          "minProperties": 1,
          "properties": { "name": { "type": "string", "minLength": 1 } },
          "patternProperties": {
            "^(?!name$).+": { "$ref": "#/definitions/canonical_resource_collection" }
          },
          "additionalProperties": false
        }
      ]
    },
    "render_intent": {
      "type": "object",
      "properties": {
        "defaults": { "$ref": "#/definitions/render_view" },
        "views": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/render_view" }
        }
      },
      "additionalProperties": false
    },
    "render_view": {
      "type": "object",
      "properties": {
        "diagram": {
          "type": "string",
          "enum": ["sppm","swimlane","spaghetti","value_stream"]
        },
        "theme": { "type": "string", "minLength": 1 },
        "style": { "$ref": "#/definitions/render_style_config" },
        "publication": { "$ref": "#/definitions/publication_config" },
        "layout": { "$ref": "#/definitions/layout_config" },
        "sppm": { "$ref": "#/definitions/sppm_config" },
        "spaghetti": { "$ref": "#/definitions/spaghetti_config" }
      },
      "additionalProperties": false
    },
    "render_style_config": {
      "type": "object",
      "properties": {
        "canvas": {
          "type": "object",
          "properties": {
            "background": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "typography": {
          "type": "object",
          "properties": {
            "font_family": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "scale": { "type": "number", "minimum": 0.75, "maximum": 1.5 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "publication_config": {
      "type": "object",
      "properties": {
        "page_format": {
          "type": "string",
          "enum": ["letter","a4","legal","tabloid"]
        },
        "margins": {
          "type": "object",
          "properties": {
            "top": { "type": "integer", "minimum": 0 },
            "right": { "type": "integer", "minimum": 0 },
            "bottom": { "type": "integer", "minimum": 0 },
            "left": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "header": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "footer": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "layout_config": {
      "type": "object",
      "properties": {
        "wrap": {
          "type": "string",
          "enum": ["none","auto","manual"]
        },
        "width": {
          "oneOf": [
            { "type": "number", "exclusiveMinimum": 0 },
            { "type": "string", "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)\\s*(?:px|in|cm|mm)?$" }
          ]
        },
        "height": {
          "oneOf": [
            { "type": "number", "exclusiveMinimum": 0 },
            { "type": "string", "pattern": "^(?:[0-9]+(?:\\.[0-9]+)?|\\.[0-9]+)\\s*(?:px|in|cm|mm)?$" }
          ]
        },
        "overflow": {
          "type": "string",
          "enum": ["error","expand","scale","paginate"]
        },
        "max_width": { "type": "integer", "minimum": 1 },
        "target_columns": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "sppm_config": {
      "type": "object",
      "properties": {
        "label_density": {
          "type": "string",
          "enum": ["full","compact","teaching"]
        },
        "node_numbering": {
          "type": "string",
          "enum": ["none","visible","hidden"]
        },
        "edge_numbering": {
          "type": "string",
          "enum": ["none","visible","hidden"]
        }
      },
      "additionalProperties": false
    },
    "spaghetti_config": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "string",
          "enum": ["material","people","equipment"]
        },
        "people_mode": {
          "type": "string",
          "enum": ["aggregate","individual"]
        },
        "strict_spatial": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
