spec_version: "0.1"

process:
  id: yb_linear
  name: Yellow Belt Linear Process

steps:
  - id: start
    kind: start
    name: Request Received

  - id: check_request
    kind: task
    name: Check Request

  - id: complete_work
    kind: task
    name: Complete Work

  - id: notify_customer
    kind: task
    name: Notify Customer

  - id: finish
    kind: end
    name: Request Closed
