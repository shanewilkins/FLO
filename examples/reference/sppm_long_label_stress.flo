spec_version: '0.1'
process:
  id: sppm_long_label_stress
  name: SPPM Long Label Stress Demonstration for Predictable Truncation Behavior
  extensions:
    footer_metrics:
      Very Long Operational Throughput Metric Name: Exceptionally verbose value text
        for clipping checks
    footer_notes:
    - This footer note is intentionally long so truncation policy behavior is easy
      to inspect.
steps:
- id: start
  kind: start
  name: Start
- id: intake_wait_queue
  kind: queue
  name: Intake Queue for Extensive Context Review
  wait_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 8
        unit: min
    primary: mean
    analysis_input: mean
- id: intake
  kind: task
  name: Intake a customer request requiring extensive descriptive context for stress
    testing
  value_class: RNVA
  cycle_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 11
        unit: min
    primary: mean
    analysis_input: mean
  performed_by:
  - Primary Intake Coordinator
  - Senior Quality Analyst
- id: quality_gate
  kind: decision
  name: Should this request continue through the accelerated quality assurance gate?
  outcomes:
    true: process_queue
    false: rework
- id: process_queue
  kind: queue
  name: Exceptionally Long Dispatch Review Queue Label
  wait_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 19
        unit: min
    primary: mean
    analysis_input: mean
- id: process
  kind: task
  name: Perform the core service operation with full traceability markers attached
  value_class: VA
  cycle_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 14
        unit: min
    primary: mean
    analysis_input: mean
  performed_by:
  - Operations Specialist
- id: rework
  kind: task
  name: Rework upstream intake details and route back for verification
  value_class: NVA
  cycle_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 7
        unit: min
    primary: mean
    analysis_input: mean
  performed_by:
  - Intake Coordinator
- id: end
  kind: end
  name: End
transitions:
- source: start
  target: intake_wait_queue
- source: intake_wait_queue
  target: intake
- source: intake
  target: quality_gate
- source: quality_gate
  target: process_queue
  outcome: Continue through quality gate with manual oversight path
- source: process_queue
  target: process
- source: process
  target: end
- source: quality_gate
  target: rework
  outcome: Return to intake and request revised package details immediately
  rework: {}
- source: rework
  target: intake_wait_queue
  rework: {}
