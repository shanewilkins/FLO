spec_version: '0.1'
process:
  id: wash_n_fold
  name: Wash n' Fold
  version: 1
steps:
- id: start
  name: Start
  kind: start
  description: Customer drops off laundry
- id: dropoff
  name: Drop-off and ticket
  kind: task
  value_class: RNVA
  cycle_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 3
        unit: min
    primary: mean
    analysis_input: mean
  performed_by:
  - Customer
  - Staff
- id: sort_tag_wait_queue
  name: Sort Queue
  kind: queue
  wait_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 8
        unit: min
    primary: mean
    analysis_input: mean
- id: sort_tag
  name: Sort and tag
  kind: task
  value_class: RNVA
  cycle_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 5
        unit: min
    primary: mean
    analysis_input: mean
  performed_by:
  - Staff
- id: wash_wait_queue
  name: Washer Queue
  kind: queue
  wait_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 18
        unit: min
    primary: mean
    analysis_input: mean
- id: wash
  name: Wash
  kind: task
  value_class: VA
  cycle_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 30
        unit: min
    primary: mean
    analysis_input: mean
  performed_by:
  - Staff
- id: dry_wait_queue
  name: Dryer Queue
  kind: queue
  wait_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 22
        unit: min
    primary: mean
    analysis_input: mean
- id: dry
  name: Dry
  kind: task
  value_class: VA
  cycle_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 45
        unit: min
    primary: mean
    analysis_input: mean
  performed_by:
  - Staff
- id: fold_package_wait_queue
  name: Folding Queue
  kind: queue
  wait_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 35
        unit: min
    primary: mean
    analysis_input: mean
- id: fold_package
  name: Fold and package
  kind: task
  value_class: VA
  cycle_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 15
        unit: min
    primary: mean
    analysis_input: mean
  performed_by:
  - Staff
- id: stage_notify_wait_queue
  name: Dispatch Queue
  kind: queue
  wait_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 12
        unit: min
    primary: mean
    analysis_input: mean
- id: stage_notify
  name: Stage and notify
  kind: task
  value_class: RNVA
  cycle_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 4
        unit: min
    primary: mean
    analysis_input: mean
  performed_by:
  - Staff
- id: payment_delivery
  name: Payment and delivery
  kind: task
  value_class: RNVA
  cycle_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 3
        unit: min
    primary: mean
    analysis_input: mean
  performed_by:
  - Customer
  - Staff
- id: end
  name: Stop
  kind: end
  description: Customer picks up clean order
