spec_version: '0.1'
process:
  id: sppm_feature_showcase_v1
  name: SPPM Feature Showcase
  extensions:
    legend_items:
      Queue: Orange upright triangles indicate staged work.
      Continuation: Labeled circles indicate page/jump anchors (P{page}-{letter}).
      Rework: Red cards and dashed returns indicate corrective loops.
    caption: Reference map covering queueing triangles, continuation anchors, expanded
      subprocess flow steps, rework, and publication footer semantics.
steps:
- id: start
  kind: start
  name: Start
- id: intake_wait_queue
  kind: queue
  name: Intake Queue
  wait_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 2
        unit: min
    primary: mean
    analysis_input: mean
- id: intake
  kind: task
  name: Intake Request
  value_class: RNVA
  description: Capture request details and context.
  cycle_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 4
        unit: min
    primary: mean
    analysis_input: mean
  performed_by:
  - Coordinator
  - Requester
- id: triage
  kind: decision
  name: Information Complete?
  outcomes:
    true: process
    false: rework_intake_wait_queue
- id: rework_intake_wait_queue
  kind: queue
  name: Rework Intake Queue
  wait_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 3
        unit: min
    primary: mean
    analysis_input: mean
- id: rework_intake
  kind: task
  name: Rework Intake Data
  value_class: RNVA
  description: Fill missing or ambiguous request data.
  cycle_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 6
        unit: min
    primary: mean
    analysis_input: mean
  changeover_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 4
        unit: min
    primary: mean
    analysis_input: mean
  performed_by:
  - Requester
- id: process_queue
  kind: queue
  name: Process Queue
  wait_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 7
        unit: min
    primary: mean
    analysis_input: mean
- id: assess_scope_wait_queue
  kind: queue
  name: Assess Scope Queue
  wait_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 1
        unit: min
    primary: mean
    analysis_input: mean
- id: assess_scope
  kind: task
  name: Assess Service Scope
  value_class: RNVA
  description: Review request details and confirm the work plan.
  cycle_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 5
        unit: min
    primary: mean
    analysis_input: mean
  changeover_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 3
        unit: min
    primary: mean
    analysis_input: mean
  performed_by:
  - Specialist
- id: execute_service_wait_queue
  kind: queue
  name: Execute Service Queue
  wait_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 6
        unit: min
    primary: mean
    analysis_input: mean
- id: execute_service
  kind: task
  name: Execute Service Activity
  value_class: VA
  description: Complete the core customer-facing service activity.
  cycle_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 13
        unit: min
    primary: mean
    analysis_input: mean
  performed_by:
  - Specialist
- id: qa
  kind: decision
  name: Quality Check Pass?
  outcomes:
    pass: complete_wait_queue
    fail: rework_quality_wait_queue
- id: rework_quality_wait_queue
  kind: queue
  name: Rework Quality Queue
  wait_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 2
        unit: min
    primary: mean
    analysis_input: mean
- id: rework_quality
  kind: task
  name: Rework Quality Issues
  value_class: NVA
  description: Correct defects found during QA.
  cycle_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 7
        unit: min
    primary: mean
    analysis_input: mean
  changeover_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 5
        unit: min
    primary: mean
    analysis_input: mean
  performed_by:
  - Specialist
- id: complete_wait_queue
  kind: queue
  name: Close Request Queue
  wait_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 9
        unit: min
    primary: mean
    analysis_input: mean
- id: complete
  kind: task
  name: Close Request
  value_class: RNVA
  description: Finalize records and communicate completion.
  cycle_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 3
        unit: min
    primary: mean
    analysis_input: mean
  performed_by:
  - Coordinator
- id: dispatch_queue_wait
  kind: queue
  name: Dispatch Queue
  wait_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 5
        unit: min
    primary: mean
    analysis_input: mean
- id: dispatch_queue
  kind: task
  name: Stage Final Packet
  value_class: RNVA
  description: Hold completed work for outbound scheduling and customer notification.
  cycle_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 2
        unit: min
    primary: mean
    analysis_input: mean
  changeover_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 2
        unit: min
    primary: mean
    analysis_input: mean
  performed_by:
  - Coordinator
- id: stop
  kind: end
  name: Stop
transitions:
- source: start
  target: intake_wait_queue
- source: intake_wait_queue
  target: intake
- source: intake
  target: triage
- source: triage
  target: process_queue
  outcome: true
- source: triage
  target: rework_intake_wait_queue
  outcome: false
  rework:
    reason: Missing details
    frequency:
      basis: estimated
      numerator: 0.12
      denominator: 1
      observation_unit: case
- source: rework_intake_wait_queue
  target: rework_intake
- source: rework_intake
  target: intake
  rework:
    extensions:
      legacy_observation:
        count: 12 per week
        frequency: 3/day
- source: process_queue
  target: assess_scope_wait_queue
- source: assess_scope_wait_queue
  target: assess_scope
- source: assess_scope
  target: execute_service_wait_queue
- source: execute_service_wait_queue
  target: execute_service
- source: execute_service
  target: qa
- source: qa
  target: complete_wait_queue
  outcome: pass
- source: complete_wait_queue
  target: complete
- source: complete
  target: dispatch_queue_wait
- source: dispatch_queue_wait
  target: dispatch_queue
- source: qa
  target: rework_quality_wait_queue
  outcome: fail
  rework:
    reason: QA defects
    frequency:
      basis: estimated
      numerator: 0.08
      denominator: 1
      observation_unit: case
- source: rework_quality_wait_queue
  target: rework_quality
- source: rework_quality
  target: assess_scope
  rework:
    extensions:
      legacy_observation:
        count: 4 per week
        frequency: 1/day
- source: dispatch_queue
  target: stop
