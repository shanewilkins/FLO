spec_version: '0.1'
process:
  id: invoice_review_v1
  name: Invoice Review (with rework)
  version: 1
  owner:
    id: fin_mgr
    name: Finance Manager
lanes:
- id: requester
  name: Requester
- id: finance
  name: Finance
steps:
- id: start
  kind: start
  name: Start
- id: submit
  kind: task
  name: Submit Invoice
  lane: requester
- id: review
  kind: task
  name: Review Invoice
  lane: finance
- id: decision
  kind: decision
  name: Valid?
- id: rework
  kind: task
  name: Request Rework
  lane: requester
- id: approve
  kind: end
  name: Approved
transitions:
- source: start
  target: submit
- source: submit
  target: review
- source: review
  target: decision
- source: decision
  target: approve
  outcome: 'true'
- source: decision
  target: rework
  outcome: 'false'
  rework: {}
- source: rework
  target: review
  rework: {}
