spec_version: '0.1'
process:
  id: riverside_current
  name: Riverside request review — current
  version: 1
  resources:
  - id: coordinator
    name: Coordinator
    kind: person
  - id: requester
    name: Requester
    kind: person
  - id: technical
    name: Technical reviewer
    kind: person
  - id: finance
    name: Finance reviewer
    kind: person
lanes:
- id: coordinator
  name: Coordinator
- id: requester
  name: Requester
- id: technical
  name: Technical reviewer
- id: finance
  name: Finance reviewer
steps:
- id: start
  kind: start
  name: Request received
- id: intake
  kind: task
  name: Register request
  lane: coordinator
  performed_by:
  - coordinator
  cycle_time:
    basis: simulated
    results:
      mean:
        method: mean
        value: 4
        unit: min
    primary: mean
    analysis_input: mean
    evidence_ref: evidence.json#/current/intake/cycle_time
    observation_count: 12
    observation_unit: activity execution
    extensions:
      riverside:
        origin: synthetic teaching summary
  wait_time:
    basis: simulated
    results:
      mean:
        method: mean
        value: 12
        unit: min
    primary: mean
    analysis_input: mean
    evidence_ref: evidence.json#/current/intake/wait_time
    observation_count: 12
    observation_unit: activity execution
    extensions:
      riverside:
        origin: synthetic teaching summary
- id: review
  kind: task
  name: Check completeness
  lane: coordinator
  performed_by:
  - coordinator
  cycle_time:
    basis: simulated
    results:
      mean:
        method: mean
        value: 6
        unit: min
    primary: mean
    analysis_input: mean
    evidence_ref: evidence.json#/current/review/cycle_time
    observation_count: 12
    observation_unit: activity execution
    extensions:
      riverside:
        origin: synthetic teaching summary
  wait_time:
    basis: simulated
    results:
      mean:
        method: mean
        value: 20
        unit: min
    primary: mean
    analysis_input: mean
    evidence_ref: evidence.json#/current/review/wait_time
    observation_count: 12
    observation_unit: activity execution
    extensions:
      riverside:
        origin: synthetic teaching summary
- id: complete
  kind: decision
  name: Request complete?
  outcomes:
    'yes': split
    clarify: clarify
- id: clarify
  kind: task
  name: Clarify request
  lane: requester
  performed_by:
  - requester
  cycle_time:
    basis: simulated
    results:
      mean:
        method: mean
        value: 8
        unit: min
    primary: mean
    analysis_input: mean
    evidence_ref: evidence.json#/current/clarify/cycle_time
    observation_count: 3
    observation_unit: activity execution
    extensions:
      riverside:
        origin: synthetic teaching summary
  description: Waiting for the requester is unknown; measure it before making an elapsed-time
    claim.
- id: split
  kind: parallel_split
  name: Both checks required
- id: technical_check
  kind: task
  name: Check feasibility
  lane: technical
  performed_by:
  - technical
  cycle_time:
    basis: simulated
    results:
      mean:
        method: mean
        value: 15
        unit: min
    primary: mean
    analysis_input: mean
    evidence_ref: evidence.json#/current/technical_check/cycle_time
    observation_count: 12
    observation_unit: activity execution
    extensions:
      riverside:
        origin: synthetic teaching summary
  wait_time:
    basis: simulated
    results:
      mean:
        method: mean
        value: 30
        unit: min
    primary: mean
    analysis_input: mean
    evidence_ref: evidence.json#/current/technical_check/wait_time
    observation_count: 12
    observation_unit: activity execution
    extensions:
      riverside:
        origin: synthetic teaching summary
- id: finance_check
  kind: task
  name: Check funding
  lane: finance
  performed_by:
  - finance
  cycle_time:
    basis: simulated
    results:
      mean:
        method: mean
        value: 10
        unit: min
    primary: mean
    analysis_input: mean
    evidence_ref: evidence.json#/current/finance_check/cycle_time
    observation_count: 12
    observation_unit: activity execution
    extensions:
      riverside:
        origin: synthetic teaching summary
  wait_time:
    basis: simulated
    results:
      mean:
        method: mean
        value: 25
        unit: min
    primary: mean
    analysis_input: mean
    evidence_ref: evidence.json#/current/finance_check/wait_time
    observation_count: 12
    observation_unit: activity execution
    extensions:
      riverside:
        origin: synthetic teaching summary
- id: join
  kind: parallel_join
  name: Both checks complete
- id: issue
  kind: task
  name: Issue response
  lane: coordinator
  performed_by:
  - coordinator
  cycle_time:
    basis: simulated
    results:
      mean:
        method: mean
        value: 3
        unit: min
    primary: mean
    analysis_input: mean
    evidence_ref: evidence.json#/current/issue/cycle_time
    observation_count: 12
    observation_unit: activity execution
    extensions:
      riverside:
        origin: synthetic teaching summary
  wait_time:
    basis: simulated
    results:
      mean:
        method: mean
        value: 0
        unit: min
    primary: mean
    analysis_input: mean
    evidence_ref: evidence.json#/current/issue/wait_time
    observation_count: 12
    observation_unit: activity execution
    extensions:
      riverside:
        origin: synthetic teaching summary
- id: end
  kind: end
  name: Response sent
transitions:
- source: start
  target: intake
- source: intake
  target: review
- source: review
  target: complete
- source: complete
  target: split
  outcome: 'yes'
- source: complete
  target: clarify
  outcome: clarify
  rework: {}
  handoff:
    type: responsibility
- source: clarify
  target: review
  rework: {}
  handoff:
    type: responsibility
- source: split
  target: technical_check
  handoff:
    type: responsibility
- source: split
  target: finance_check
  handoff:
    type: responsibility
- source: technical_check
  target: join
  handoff:
    type: responsibility
- source: finance_check
  target: join
  handoff:
    type: responsibility
- source: join
  target: issue
- source: issue
  target: end
