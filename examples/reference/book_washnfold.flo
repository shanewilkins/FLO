transitions:
- source: start
  target: dropoff
- source: dropoff
  target: sort_tag
- source: sort_tag
  target: wash_release_queue
- source: wash_release_queue
  target: wash
- source: wash
  target: dry
- source: dry
  target: fold_package
- source: fold_package
  target: packaging_check
- source: packaging_check
  target: notification_queue
  outcome: acceptable
- source: notification_queue
  target: stage_collection
- source: stage_collection
  target: send_notification
- source: packaging_check
  target: correction_queue
  outcome: correction_required
  label: Packaging check fails (5 of 39 orders)
  rework:
    reason: Packaging check fails
    frequency:
      basis: simulated
      numerator: 5
      denominator: 39
      observation_unit: orders
      evidence_ref: book:washnfold_representative_activity_summary#Fold correction
- source: correction_queue
  target: fold_correction
- source: fold_correction
  target: notification_queue
  label: Corrected package rejoins flow
  rework: {}
- source: send_notification
  target: end
