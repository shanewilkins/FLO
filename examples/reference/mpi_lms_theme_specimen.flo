spec_version: "0.1"

process:
  id: mpi_lms_theme_specimen
  name: MPI-LMS Theme Specimen

steps:
  - id: start
    kind: start
    name: Start

  - id: receive
    kind: task
    name: Receive request
    metadata:
      value_class: RNVA
      cycle_time: {value: 3, unit: min}

  - id: improve
    kind: task
    name: Improve product
    metadata:
      value_class: VA
      cycle_time: {value: 12, unit: min}

  - id: review_queue
    kind: queue
    name: Review queue
    metadata:
      wait_time: {value: 8, unit: min}

  - id: inspect
    kind: decision
    name: Product defective?

  - id: correct
    kind: task
    name: Correct defect
    metadata:
      value_class: NVA
      cycle_time: {value: 5, unit: min}

  - id: complete
    kind: end
    name: Complete

transitions:
  - source: start
    target: receive
  - source: receive
    target: improve
  - source: improve
    target: review_queue
  - source: review_queue
    target: inspect
  - source: inspect
    target: correct
    outcome: "yes"
    label: "Yes"
  - source: correct
    target: inspect
    edge_type: rework
    rework: true
    label: Recheck
  - source: inspect
    target: complete
    outcome: "no"
    label: "No"
