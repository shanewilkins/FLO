spec_version: '0.1'
process:
  id: mpi_lms_theme_specimen
  name: MPI-LMS Theme Specimen
steps:
- id: start
  kind: start
  name: Start
- id: receive
  kind: task
  name: Receive request
  value_class: RNVA
  cycle_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 3
        unit: min
    primary: mean
    analysis_input: mean
- id: improve
  kind: task
  name: Improve product
  value_class: VA
  cycle_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 12
        unit: min
    primary: mean
    analysis_input: mean
- id: review_queue
  kind: queue
  name: Review queue
  wait_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 8
        unit: min
    primary: mean
    analysis_input: mean
- id: inspect
  kind: decision
  name: Product defective?
- id: correct
  kind: task
  name: Correct defect
  value_class: NVA
  cycle_time:
    basis: estimated
    results:
      mean:
        method: mean
        value: 5
        unit: min
    primary: mean
    analysis_input: mean
- id: complete
  kind: end
  name: Complete
transitions:
- source: start
  target: receive
- source: receive
  target: improve
- source: improve
  target: review_queue
- source: review_queue
  target: inspect
- source: inspect
  target: correct
  outcome: 'yes'
  label: 'Yes'
- source: correct
  target: inspect
  label: Recheck
  rework: {}
- source: inspect
  target: complete
  outcome: 'no'
  label: 'No'
