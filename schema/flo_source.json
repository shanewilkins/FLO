    "MeasureQuantity": {
      "additionalProperties": false,
      "description": "A measured amount; dimensional equivalence remains domain-owned.",
      "properties": {
        "kind": {
          "const": "measure",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "gt": 0,
          "title": "Value"
        },
        "unit": {
          "pattern": "\\S",
          "title": "Unit",
          "type": "string"
        },
        "canonical_value": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ],
              "gt": 0
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Value"
        },
        "canonical_unit": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Unit"
        }
      },
      "required": [
        "kind",
        "value",
        "unit"
      ],
      "title": "MeasureQuantity",
      "type": "object"
    },
    "Measurement": {
      "oneOf": [
        {
          "$ref": "#/$defs/MeasurementProfile"
        },
        {
          "$ref": "#/$defs/MeasurementReference"
        }
      ]
    },
    "MeasurementProfile": {
      "additionalProperties": false,
      "description": "A supplied measurement profile with explicit evidence and selectors.",
      "properties": {
        "basis": {
          "enum": [
            "observed",
            "simulated",
            "estimated",
            "planned",
            "target"
          ],
          "title": "Basis",
          "type": "string"
        },
        "results": {
          "minProperties": 1,
          "patternProperties": {
            "\\S": {
              "$ref": "#/$defs/MeasurementResult"
            }
          },
          "title": "Results",
          "type": "object"
        },
        "primary": {
          "pattern": "\\S",
          "title": "Primary",
          "type": "string"
        },
        "analysis_input": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analysis Input"
        },
        "observation_count": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observation Count"
        },
        "observation_unit": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observation Unit"
        },
        "cohort": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cohort"
        },
        "aggregation_level": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aggregation Level"
        },
        "observation_window": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observation Window"
        },
        "evidence_ref": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Ref"
        },
        "extensions": {
          "anyOf": [
            {
              "$ref": "#/$defs/Extensions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "basis",
        "results",
        "primary"
      ],
      "title": "MeasurementProfile",
      "type": "object"
    },
    "MeasurementReference": {
      "additionalProperties": false,
      "description": "A reference to a measurement owned by another process step.",
      "properties": {
        "ref": {
          "pattern": "^[\\s\\S]*\\S[\\s\\S]*\\.[a-z_]+$",
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "ref"
      ],
      "title": "MeasurementReference",
      "type": "object"
    },
    "MeasurementResult": {
      "additionalProperties": false,
      "description": "One named statistical result within a measurement profile.",
      "properties": {
        "method": {
          "anyOf": [
            {
              "enum": [
                "count",
                "sum",
                "minimum",
                "maximum",
                "mean",
                "median",
                "mode",
                "percentile",
                "standard_deviation"
              ],
              "type": "string"
            },
            {
              "pattern": "^[a-z][a-z0-9_.-]*:[a-z][a-z0-9_.-]*$",
              "type": "string"
            }
          ],
          "title": "Method"
        },
        "value": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ],
              "ge": 0
            },
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "items": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "array"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "pattern": "\\S",
          "title": "Unit",
          "type": "string"
        },
        "parameters": {
          "anyOf": [
            {
              "additionalProperties": {
                "$ref": "#/$defs/JsonValue"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parameters"
        }
      },
      "required": [
        "method",
        "value",
        "unit"
      ],
      "title": "MeasurementResult",
      "type": "object"
    },
    "NamedIdentity": {
      "additionalProperties": false,
