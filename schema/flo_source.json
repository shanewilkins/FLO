    "BranchConfig": {
      "additionalProperties": false,
      "description": "Authored branch selection mechanism and optional resource eligibility.",
      "properties": {
        "mode": {
          "enum": [
            "dispatch",
            "probabilistic",
            "external",
            "unspecified"
          ],
          "title": "Mode",
          "type": "string"
        },
        "policy": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy"
        },
        "eligible_resources": {
          "anyOf": [
            {
              "items": {
                "pattern": "\\S",
                "type": "string"
              },
              "minItems": 1,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Eligible Resources"
        }
      },
      "required": [
        "mode"
      ],
      "title": "BranchConfig",
      "type": "object"
    },
    "BusinessUnit": {
      "additionalProperties": false,
      "description": "Named process grouping without a lane-type classification.",
      "properties": {
        "id": {
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "pattern": "\\S",
          "title": "Name",
          "type": "string"
        },
        "extensions": {
          "anyOf": [
