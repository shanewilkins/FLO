        "kind"
      ],
      "title": "ItemContract",
      "type": "object"
    },
    "JsonValue": {},
    "LocationContract": {
      "additionalProperties": false,
      "description": "A named operational place with optional spatial evidence.",
      "properties": {
        "id": {
          "pattern": "\\S",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "pattern": "\\S",
          "title": "Name",
