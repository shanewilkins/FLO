    "Quantity": {
      "discriminator": {
        "mapping": {
          "count": "#/$defs/CountQuantity",
          "measure": "#/$defs/MeasureQuantity"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/CountQuantity"
