              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "BusinessUnit",
      "type": "object"
    },
    "CountQuantity": {
      "additionalProperties": false,
      "description": "An integral count of indivisible entities.",
      "properties": {
        "kind": {
          "const": "count",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "exclusiveMinimum": 0,
          "title": "Value",
          "type": "integer"
        },
        "unit": {
          "anyOf": [
            {
              "const": "each",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "qualifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qualifier"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "CountQuantity",
      "type": "object"
    },
