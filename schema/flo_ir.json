    "MeasurementReference": {
      "additionalProperties": false,
      "description": "A reference to a measurement owned by another process step.",
      "properties": {
        "ref": {
          "pattern": "^[A-Za-z0-9_.-]+\\.[a-z_]+$",
          "title": "Ref",
          "type": "string"
        }
      },
      "required": [
        "ref"
      ],
      "title": "MeasurementReference",
      "type": "object"
    },
    "MeasurementResult": {
      "additionalProperties": false,
      "description": "One named statistical result within a measurement profile.",
      "properties": {
        "method": {
          "anyOf": [
            {
              "enum": [
                "count",
                "sum",
                "minimum",
                "maximum",
                "mean",
                "median",
                "mode",
                "percentile",
                "standard_deviation"
              ],
              "type": "string"
