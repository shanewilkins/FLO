{
  "$defs": {
    "CanonicalEdgeContract": {
      "additionalProperties": false,
      "description": "Generated-schema boundary for one canonical transition.",
      "properties": {
        "source": {
          "pattern": "\\S",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "pattern": "\\S",
          "title": "Target",
          "type": "string"
        },
        "id": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "outcome": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Outcome"
        },
        "route": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route"
        },
        "label": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "handoff": {
          "anyOf": [
            {
              "$ref": "#/$defs/HandoffRelation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rework": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReworkRelation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "extensions": {
          "anyOf": [
            {
              "$ref": "#/$defs/Extensions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "CanonicalEdgeContract",
      "type": "object"
    },
    "CanonicalIdentityContract": {
