    "MeasureQuantity": {
      "additionalProperties": false,
      "description": "A measured amount; dimensional equivalence remains domain-owned.",
      "properties": {
        "kind": {
          "const": "measure",
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            }
          ],
          "gt": 0,
          "title": "Value"
        },
        "unit": {
          "pattern": "\\S",
          "title": "Unit",
          "type": "string"
        },
        "canonical_value": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                }
              ],
              "gt": 0
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Value"
        },
        "canonical_unit": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Unit"
        }
      },
      "required": [
        "kind",
        "value",
        "unit"
      ],
      "title": "MeasureQuantity",
      "type": "object"
    },
