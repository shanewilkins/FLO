      "anyOf": [
        {
          "$ref": "#/$defs/MeasurementProfile"
        },
        {
          "$ref": "#/$defs/MeasurementReference"
        }
      ]
    },
    "MeasurementProfile": {
      "additionalProperties": false,
      "description": "A supplied measurement profile with explicit evidence and selectors.",
      "properties": {
        "basis": {
          "enum": [
            "observed",
            "simulated",
            "estimated",
            "planned",
            "target"
          ],
          "title": "Basis",
          "type": "string"
        },
        "results": {
          "minProperties": 1,
          "patternProperties": {
            "\\S": {
              "$ref": "#/$defs/MeasurementResult"
            }
          },
          "title": "Results",
          "type": "object"
        },
        "primary": {
          "pattern": "\\S",
          "title": "Primary",
          "type": "string"
        },
        "analysis_input": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analysis Input"
        },
        "observation_count": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
